    CONTROL         "Import existing map",IDC_IMPORT,"Button",BS_AUTORADIOBUTTON | WS_GROUP,7,81,234,11
    CONTROL         "Create new map",IDC_NEW,"Button",BS_AUTORADIOBUTTON,7,8,234,15
