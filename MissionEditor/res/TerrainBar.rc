    COMBOBOX        IDC_OVERLAY, 63, 28, 191, 163, CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Tile Manager", IDC_TERRAINBAR_MANAGER, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 7, 46, 65, 17 
    CONTROL         "Terrain Generator", IDC_TERRAINBAR_GENERATOR, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 167, 46, 65, 17
END


