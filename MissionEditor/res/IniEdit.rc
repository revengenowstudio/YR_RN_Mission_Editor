/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ALL DIALOGEX 0, 0, 397, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "INI Editor"
FONT 8, "Tahoma", 0, 0, 0x0
BEGIN
    LTEXT           "We highly recommend not to use this editor except you really know what you are doing.",IDC_INI_EDITOR_DESC,6,5,290,15
    LTEXT           "Search:",IDC_INI_EDITOR_TXT_SEARCH,7,23,30,12
    PUSHBUTTON      "New Section",IDC_ADDSECTION,222,20,50,14
    PUSHBUTTON      "Delete",IDC_DELETESECTION,277,20,40,14
    PUSHBUTTON      "Import From File",IDC_INISECTION,322,20,68,14
    EDITTEXT        IDC_EDITOR_SEARCH,40,21,87,14,ES_AUTOHSCROLL
    LISTBOX         IDC_EDITOR_SECTIONS,7,40,120,250,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_INI_EDITOR_CONTENT,"RichEdit20A",ES_MULTILINE | WS_BORDER | WS_VSCROLL | WS_TABSTOP,133,40,257,250
    PUSHBUTTON      "Edit",IDC_EDITOR_EDIT_BUTTON,146,20,68,14
END

IDD_IMPORTINI DIALOG 0, 0, 229, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Insert INI file section"
FONT 8, "Tahoma"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,170,5,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,170,25,50,14
    LTEXT           "Choose the sections you want to import in the map. Be careful! If you import a section that already exists, keys of the already existing section may be overwritten!",IDC_STATIC,5,5,155,35
    LISTBOX         IDC_AVAILABLE,5,75,215,55,LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Available sections:",IDC_STATIC,5,65,100,10
    CONTROL         "Import all sections",IDC_ALLSECTIONS,"Button",BS_AUTORADIOBUTTON,5,40,155,10
    CONTROL         "Specify sections to be imported",IDC_SPECIFYSECTIONS,
                    "Button",BS_AUTORADIOBUTTON,5,50,150,10
    LTEXT           "Select the sections you wish to import.",IDC_STATIC,5,135,215,10
END

IDD_INI_EDITOR DIALOGEX 0, 0, 309, 176
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ini Section Editor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,198,155,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,252,155,50,14
    CONTROL         "",IDC_SECTION_TEXT,"RichEdit20A",ES_MULTILINE | WS_BORDER | WS_VSCROLL | WS_TABSTOP,23,40,261,110
    LTEXT           "Current section:",IDC_INI_E_CUR_SEC,23,22,68,8
    EDITTEXT        IDC_INI_E_CUR_SEC_VAL,103,20,180,14,ES_AUTOHSCROLL
    CONTROL         "Disable validation",IDC_INI_E_DISABLE_VALIDATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,154,99,15
END


