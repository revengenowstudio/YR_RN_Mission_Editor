    LTEXT           "PreMapSelect:",IDC_LPREMAPSELECT,153,160,59,18
    COMBOBOX        IDC_PREMAPSELECT,216,160,68,225,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
