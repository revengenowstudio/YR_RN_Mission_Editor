    GROUPBOX        "Movies",IDC_LMOVIES,7,117,289,81
    LTEXT           "Intro:",IDC_LINTRO,15,128,59,18
    COMBOBOX        IDC_INTRO,75,128,68,161,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Brief:",IDC_LBRIEF,15,144,59,18
    COMBOBOX        IDC_BRIEF,75,144,68,202,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Win:",IDC_LWIN,15,160,59,18
    COMBOBOX        IDC_WIN,75,160,68,185,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Lose:",IDC_LLOSE,14,177,59,15
    COMBOBOX        IDC_LOSE,75,176,68,203,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Action:",IDC_LACTION,154,128,59,18
    COMBOBOX        IDC_ACTION,216,128,68,160,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
